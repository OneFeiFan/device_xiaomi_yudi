diff --git a/partitionmanager.cpp b/partitionmanager.cpp
index bae39cd..73d9c5c 100755
--- a/partitionmanager.cpp
+++ b/partitionmanager.cpp
@@ -346,6 +346,45 @@ bool TWPartitionManager::Disable_AVB2(bool Display_Info) {
 #endif
 }
 
+#ifdef OF_RECOVERY_DISABLE_CHECKPOINT
+// vold/fs_mgr adds checkpoint=disable when the vendor fstab carries
+// checkpoint=fs. Recovery writes would then be rolled back on reboot.
+// Drop the flag before passing the additional fstab to vold.
+static void Remove_Checkpoint_Fs(const std::string& path) {
+	std::vector<std::string> lines;
+	if (TWFunc::read_file(path, lines) != 0)
+		return;
+
+	bool changed = false;
+	const std::string flag = "checkpoint=fs";
+	for (auto& line : lines) {
+		size_t pos;
+		while ((pos = line.find(flag)) != std::string::npos) {
+			size_t start = pos;
+			if (start > 0 && line[start - 1] == ',')
+				--start;
+			size_t end = pos + flag.length();
+			if (start == pos && end < line.length() && line[end] == ',')
+				++end;
+			line.erase(start, end - start);
+			changed = true;
+		}
+	}
+	if (!changed)
+		return;
+
+	FILE* fp = fopen(path.c_str(), "w");
+	if (!fp) {
+		LOGERR("Unable to rewrite %s\n", path.c_str());
+		return;
+	}
+	for (const auto& line : lines)
+		fprintf(fp, "%s\n", line.c_str());
+	fclose(fp);
+	LOGINFO("Removed checkpoint=fs from %s\n", path.c_str());
+}
+#endif
+
 int TWPartitionManager::Process_Fstab(string Fstab_Filename, bool Display_Error, bool recovery_mode) {
 	FILE *fstabFile;
 	char fstab_line[MAX_FSTAB_LINE_LENGTH];
@@ -505,6 +544,9 @@ clear:
 		if (TWFunc::Find_Fstab(Fstab_Filename)) {
 			LOGINFO("Fstab: %s\n", Fstab_Filename.c_str());
 			TWFunc::copy_file(Fstab_Filename, additional_fstab, 0600, false);
+#ifdef OF_RECOVERY_DISABLE_CHECKPOINT
+			Remove_Checkpoint_Fs(additional_fstab);
+#endif
 			Fstab_Filename = additional_fstab;
 			property_set("fstab.additional", "1");
 			goto parse;
