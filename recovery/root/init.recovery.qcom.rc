# 小米平板 6 Max 14（yudi）recovery 的设备初始化
#
# 由 /init.rc 按 ro.hardware 自动导入：vendor_boot 的 bootconfig 设置了 androidboot.hardware=qcom。
# 音频、ADSP、USB 和电池部分照搬原厂 recovery 的 init.recovery.qcom.rc；解密部分启动 vendor 的安全服务，
# 服务定义来自原厂 vendor 的 rc 文件（recovery/root/vendor/etc/init/）。

on early-init
    # 原厂 recovery 同样在这里加载：ADSP 启动后，电池驱动才能拿到电量
    insmod /vendor/lib/modules/q6_pdr_dlkm.ko
    insmod /vendor/lib/modules/q6_notifier_dlkm.ko
    insmod /vendor/lib/modules/snd_event_dlkm.ko
    insmod /vendor/lib/modules/gpr_dlkm.ko
    insmod /vendor/lib/modules/spf_core_dlkm.ko
    insmod /vendor/lib/modules/adsp_loader_dlkm.ko

on init
    setprop sys.usb.configfs 1
    # 触控固件放在 ramdisk 的 /lib/firmware：/vendor/firmware 之后会被 ADSP 固件覆盖
    write /sys/module/firmware_class/parameters/path /lib/firmware

on property:ro.boot.usbcontroller=*
    setprop sys.usb.controller ${ro.boot.usbcontroller}
    wait /sys/bus/platform/devices/${ro.boot.usb.dwc3_msm:-a600000.ssusb}/mode
    write /sys/bus/platform/devices/${ro.boot.usb.dwc3_msm:-a600000.ssusb}/mode idle
    wait /sys/class/udc/${ro.boot.usbcontroller} 0
    write /sys/bus/platform/devices/${ro.boot.usb.dwc3_msm:-a600000.ssusb}/mode peripheral
    wait /sys/class/udc/${ro.boot.usbcontroller} 1

on fs
    wait /dev/block/platform/soc/${ro.boot.bootdevice}
    symlink /dev/block/platform/soc/${ro.boot.bootdevice} /dev/block/bootdevice
    write /proc/sys/kernel/firmware_config/force_sysfs_fallback 1

    # ADSP 固件在 modem 分区，挂载后绑定到 /vendor/firmware，再启动 ADSP
    mkdir /vendor/firmware_mnt
    mkdir /vendor/firmware
    mount_all /vendor/etc/charger_fstab.qti --early
    mount none /vendor/firmware_mnt/image /vendor/firmware bind rec
    wait /sys/kernel/boot_adsp/boot
    write /sys/kernel/boot_adsp/boot 1
    wait /sys/class/power_supply/battery

    # 解密服务的库在 /vendor/lib64；Gatekeeper 的实现库在 /vendor/lib64/hw
    export LD_LIBRARY_PATH /system/lib64:/vendor/lib64:/vendor/lib64/hw

    # A/B 槽位控制：原厂 vendor 的 boot HAL（HIDL 1.2）
    start vendor.boot-hal-1-2

    # 解密：qseecomd 需要的设备节点权限和工作目录
    chmod 0660 /dev/qseecom
    chown system drmrpc /dev/qseecom
    chmod 0664 /dev/ion
    chown system system /dev/ion
    mkdir /mnt/vendor 0775 root system
    mkdir /mnt/vendor/persist 0775 root system
    mount ext4 /dev/block/bootdevice/by-name/persist /mnt/vendor/persist nosuid nodev noatime barrier=1
    mkdir /data/vendor 0771 system system
    mkdir /data/vendor/tzstorage 0770 system system
    install_keyring
    start vendor.qseecomd
    start qseecom-service

# qseecomd 注册完监听器后，启动依赖它的密钥服务
on property:vendor.sys.listeners.registered=true
    start vendor.keymaster-4-1
    start gatekeeper-1-0
    start vendor.keymint-qti
