<?xml version="1.0"?>
<recovery>
<variables>
		<variable name="adb_startup" value="%adb_startup%" persist="1"/>
		<variable name="auto_show_btns" value="%auto_show_btns%" persist="1"/>
		<variable name="enable_battery" value="%enable_battery%" persist="1"/>
		<variable name="floating_panel" value="%floating_panel%" persist="1"/>
		<variable name="fm_auto_open" value="%fm_auto_open%" persist="1"/>
		<variable name="fox_adv_backup" value="%fox_adv_backup%" persist="1"/>
		<variable name="fox_boot_balance_check" value="%fox_boot_balance_check%" persist="1"/>
		<variable name="fox_boot_fastcharge_check" value="%fox_boot_fastcharge_check%" persist="1"/>
		<variable name="fox_boot_performance_check" value="%fox_boot_performance_check%" persist="1"/>
		<variable name="fox_boot_powersave_check" value="%fox_boot_powersave_check%" persist="1"/>
		<variable name="fox_disable_ota_auto_reboot_check" value="%fox_disable_ota_auto_reboot_check%" persist="1"/>
		<variable name="fox_include_system_survival" value="%fox_include_system_survival%" persist="1"/>
		<variable name="fox_led_color" value="%fox_led_color%" persist="1"/>
		<variable name="fox_reboot_advanced_stock_recovery_check" value="%fox_reboot_advanced_stock_recovery_check%" persist="1"/>
		<variable name="fox_reboot_dm_verity_check" value="%fox_reboot_dm_verity_check%" persist="1"/>
		<variable name="fox_reboot_forced_encryption_check" value="%fox_reboot_forced_encryption_check%" persist="1"/>
		<variable name="fox_support_miui_ota" value="%fox_support_miui_ota%" persist="1"/>
		<variable name="fox_verify_incremental_ota_signature" value="%fox_verify_incremental_ota_signature%" persist="1"/>
		<variable name="gst_back_left" value="%gst_back_left%" persist="1"/>
		<variable name="gst_back_right" value="%gst_back_right%" persist="1"/>
		<variable name="gst_console" value="%gst_console%" persist="1"/>
		<variable name="hide_notch" value="%hide_notch%" persist="1"/>
		<variable name="instant_apply" value="%instant_apply%" persist="1"/>
		<variable name="key_allow_swipe" value="%key_allow_swipe%" persist="1"/>
		<variable name="key_numbar" value="%key_numbar%" persist="1"/>
		<variable name="list_font" value="%list_font%" persist="1"/>
		<variable name="lock_action" value="%lock_action%" persist="1"/>
		<variable name="lock_btn" value="%lock_btn%" persist="1"/>
		<variable name="lock_info" value="%lock_info%" persist="1"/>
		<variable name="navbar_sams" value="%navbar_sams%" persist="1"/>
		<variable name="of_keep_storage_data" value="%of_keep_storage_data%" persist="1"/>
		<variable name="ota_new_screen" value="%ota_new_screen%" persist="1"/>
		<variable name="show_cpu_temp" value="%show_cpu_temp%" persist="1"/>
		<variable name="show_slideout" value="%show_slideout%" persist="1"/>
		<variable name="spl_ofr" value="%spl_ofr%" persist="1"/>
		<variable name="tw_auto_disable_avb2" value="%tw_auto_disable_avb2%" persist="1"/>
		<variable name="tw_auto_reflashtwrp" value="%tw_auto_reflashtwrp%" persist="1"/>
		<variable name="tw_disable_free_space" value="%tw_disable_free_space%" persist="1"/>
		<variable name="tw_flash_both_slots" value="%tw_flash_both_slots%" persist="1"/>
		<variable name="tw_hidden_files" value="%tw_hidden_files%" persist="1"/>
		<variable name="tw_include_kernel_log" value="%tw_include_kernel_log%" persist="1"/>
		<variable name="tw_include_logcat" value="%tw_include_logcat%" persist="1"/>
		<variable name="tw_inject_after_zip" value="%tw_inject_after_zip%" persist="1"/>
		<variable name="tw_install_reboot" value="%tw_install_reboot%" persist="1"/>
		<variable name="tw_military_time" value="%tw_military_time%" persist="1"/>
		<variable name="tw_never_show_system_ro_page" value="%tw_never_show_system_ro_page%" persist="1"/>
		<variable name="tw_repack_backup_first" value="%tw_repack_backup_first%" persist="1"/>
		<variable name="tw_rm_rf" value="%tw_rm_rf%" persist="1"/>
		<variable name="tw_signed_zip_verify" value="%tw_signed_zip_verify%" persist="1"/>
		<variable name="tw_simulate_actions" value="%tw_simulate_actions%" persist="1"/>
		<variable name="tw_simulate_fail" value="%tw_simulate_fail%" persist="1"/>
		<variable name="tw_skip_digest_check" value="%tw_skip_digest_check%" persist="1"/>
		<variable name="tw_skip_digest_generate" value="%tw_skip_digest_generate%" persist="1"/>
		<variable name="tw_time_zone_guidst" value="%tw_time_zone_guidst%" persist="1"/>
		<variable name="tw_unmount_system" value="%tw_unmount_system%" persist="1"/>
		<variable name="tw_unmount_vendor" value="%tw_unmount_vendor%" persist="1"/>
		<variable name="tw_use_compression" value="%tw_use_compression%" persist="1"/>
		<variable name="tw_use_sha2" value="%tw_use_sha2%" persist="1"/>
		<variable name="tw_wipe_cache" value="%tw_wipe_cache%" persist="1"/>
		<variable name="tw_wipe_dalvik" value="%tw_wipe_dalvik%" persist="1"/>
		<variable name="use_fixed_font" value="%use_fixed_font%" persist="1"/>
	</variables>

	<pages>
		<page name="main">
			<!-- Reboot if failed last time  -->
			<action>
				<condition var1="need_reboot" var2="1"/>
				<action function="need_reboot">%tw_reboot_param%</action>
			</action>

			<!-- DEBUG -->
			<action>
<!--				<condition var1="fox_lab" var2="1"/>-->
				<action function="overlay"/>
				<action function="set">tw_clear_destination=ext_custom_status</action>
				<action function="page">clear_vars</action>
			</action>

			<!-- Show welcome page after installing OF -->
			<action>
				<condition var1="first_start" var2="1"/>
				<action function="page">welcome</action>
			</action>

			<!-- Stop MTP when using pass -->
			<action>
				<condition var1="first_start" op="!=" var2="1"/>
				<condition var1="fox_use_pass" var2="1"/>
				<condition var1="pass_open" var2="0"/>
				<condition var1="tw_has_mtp" var2="1"/>
				<condition var1="tw_mtp_enabled" var2="1"/>
				<action function="stopmtp"/>
			</action>
			
			<!-- Go to pass page -->
			<action>
				<condition var1="first_start" op="!=" var2="1"/>
				<condition var1="fox_use_pass" var2="1"/>
				<condition var1="pass_open" var2="0"/>
				<action function="adb">disable</action>
				<action function="set">pass_enter=</action>
				<action function="set">pass_enter_hash=</action>
				<action function="set">pass_not_match=0</action>
				<action function="page">password_enter</action>
			</action>

			<!-- Enable ADB & MTP -->
			<action>
				<condition var1="first_start" op="!=" var2="1"/>
				<condition var1="fox_use_pass" op="!=" var2="1"/>
				<condition var1="adb_startup" var2="1"/>
				<condition var1="adb_started" op="!=" var2="1"/>
				<condition var1="fox_advanced_security" var2="1"/>
				<condition var1="tw_has_mtp" var2="1"/>
				<action function="startmtp"/>
			</action>
			<action>
				<condition var1="first_start" op="!=" var2="1"/>
				<condition var1="fox_use_pass" op="!=" var2="1"/>
				<condition var1="adb_startup" var2="1"/>
				<condition var1="adb_started" op="!=" var2="1"/>
				<condition var1="fox_advanced_security" var2="1"/>
				<action function="adb">enable</action>
				<action function="set">adb_started=1</action>
			</action>


			<!-- Go to FM -->
			<action>
				<condition var1="first_start" op="!=" var2="1"/>
				<condition var1="fox_use_pass" op="!=" var2="1"/>
				<action function="overlay"/>
				<action function="set">tw_clear_destination=navbar</action>
				<action function="page">clear_vars</action>
			</action>

			<action>
				<condition var1="first_start" op="!=" var2="1"/>
				<condition var1="fox_use_pass" var2="1"/>
				<condition var1="pass_open" var2="1"/>
				<action function="overlay"/>
				<action function="set">tw_clear_destination=navbar</action>
				<action function="page">clear_vars</action>
			</action>
		</page>


		<page name="navbar">
			<action>
				<condition var1="nav_panel_id" var2="0"/>
				<action function="page">filemanagerlist</action>
			</action>
			<action>
				<condition var1="nav_panel_id" var2="1"/>
				<action function="page">restore</action>
			</action>
			<action>
				<condition var1="nav_panel_id" var2="2"/>
				<action function="page">wipe</action>
			</action>
			<action>
				<condition var1="nav_panel_id" var2="3"/>
				<action function="page">advanced</action>
			</action>
		</page>

		<page name="welcome">
			<background color="%background%"/>
			<template name="keys"/>

			<image>
				<image resource="splash_logo_o"/>
				<placement x="%center_x%" y="%welcome_logo%" placement="4"/>
			</image>

			<text style="text_ab_title">
				<placement x="%center_x%" y="%welcome_text%" placement="4"/>
				<text>{@welcome_msg}</text>
			</text>

			<text style="text_ab_title">
				<placement x="%center_x%" y="%welcome_text2%" placement="4"/>
				<text>{@welcome_msg2}</text>
			</text>
			
			<image>
				<placement x="%center_x%" y="%btn_float_center_y%" placement="4"/>
				<image resource="fab_shadow"/>
			</image>

			<button style="floating_btn">
				<placement x="%center_x%" y="%btn_float_center_y%" placement="4"/>
				<action function="set">first_start=0</action>
				<action function="page">main</action>
			</button>
			
			<image>
				<placement x="%center_x%" y="%btn_float_center_y%" placement="4"/>
				<image resource="fab_accept"/>
			</image>
		</page>

		<page name="aroma_busy">
			<background color="%background%"/>
			<template name="status_bg"/>
			<template name="statusbarinfo"/>
			
			<text style="text_status">
				<placement x="%center_x%" y="%center_y%" placement="5"/>
				<text>{@lang_wait}</text>
			</text>

			<action>
				<condition var1="tw_operation_state" var2="1"/>
				<action function="set">tw_signed_zip_verify=%tw_signed_zip_verify_tmp%</action>
				<action function="set">fox_inject_after_zip=%fox_inject_after_zip_tmp%</action>
				<action function="set">tw_screen_timeout_secs=%tw_screen_timeout_temp%</action>
			</action>

			<action>
				<condition var1="tw_operation_state" var2="1"/>
				<condition var1="tw_operation_status" op="!=" var2="0"/>
				<action function="set">install_back=advanced</action>
				<action function="page">flash_done</action>
			</action>

			<action>
				<condition var1="tw_operation_state" var2="1"/>
				<condition var1="tw_operation_status" var2="0"/>
				<action function="disableled"/>
				<action function="page">advanced</action>
			</action>
		</page>

        <page name="fastboot">
			<background color="%background%"/>
			<template name="keys"/>
			<action>
				<action function="set">tw_back=fastboot</action>
			</action>

			<console>
				<placement x="%col1_x%" y="%console_ab_y%" w="%console_width%" h="%console_fastboot_height%"/> 
				<condition var1="use_fixed_font" var2="0"/>
			</console>
			
			<console>
				<placement x="%col1_x%" y="%console_ab_y%" w="%console_width%" h="%console_fastboot_height%"/> 
				<condition var1="use_fixed_font" var2="1"/>
				<font resource="fixed"/>
			</console>

			<progressbar>
				<condition var1="ui_progress" op="&lt;" var2="100"/>
				<condition var1="ui_progress" op="&gt;" var2="0"/>
				<placement x="%progressbar_x%" y="%ab_h%"/>
				<resource empty="progress_empty" full="progress_fill"/>
				<data name="ui_progress"/>
			</progressbar>
			
			<animation>
				<condition var1="ui_progress" var2="100"/>
				<placement x="%progressbar_x%" y="%ab_h%"/>
				<resource name="progress"/>
				<speed fps="30" render="1"/>
				<loop frame="1"/>
			</animation>

			<template name="ab_main"/>
			<template name="statusbarinfo"/>
			<template name="gestures"/>
 			<template name="navbar"/>

			<text style="text_ab_title">
				<placement x="%col1_x%" y="%ab_bc_y%"/>
				<text>{@fastboot_button}</text>
			</text>

			<button style="btn_raised">
				<placement x="%btn_raised_left_x%" y="%row_btn1_y%"/>
				<text>{@reboot_btn}</text>
				<action function="overlay">reboot</action>
			</button>

			<button style="btn_raised_hl">
				<condition var1="tw_enable_adb" var2="1" />
				<placement x="%btn_raised_right_x%" y="%row_btn1_y%" placement="1"/>
				<text>{@enable_fastboot}</text>
				<action function="enablefastboot"/>
				<action function="set">tw_enable_fastboot=1</action>
				<action function="set">tw_enable_adb=0</action>
			</button>

			<button style="btn_raised_hl">
				<condition var1="tw_enable_fastboot" var2="1" />
				<placement x="%btn_raised_right_x%" y="%row_btn1_y%" placement="1"/>
				<text>{@enable_adb}</text>
				<action function="enableadb"/>
				<action function="set">tw_enable_adb=1</action>
				<action function="set">tw_enable_fastboot=0</action>
			</button>
		</page>
	</pages>
</recovery>
