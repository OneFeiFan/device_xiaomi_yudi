service vendor.keymint-qti /vendor/bin/hw/android.hardware.security.keymint-service-qti
    setenv LD_LIBRARY_PATH /vendor/lib64/vndk-v32:/vendor/lib64:/vendor/lib64/hw:/system/lib64
    class early_hal
    user system
    group system drmrpc
    disabled
    seclabel u:r:recovery:s0
